__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# ---------- Virtual environments ----------
.venv/
venv/
env/

# ---------- IDE / editors ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Test / dev artefacts ----------
tests/test_*.py
!tests/test_vrm_api.py
!tests/test_sensor_logic.py
api_data_*/
*.tmp
hacs.json.tmp

# ---------- Deployment scripts (local only) ----------
scripts/deploy_to_ha.ps1
docs/DEPLOY_LOCAL.md

# ---------- Historical / backup ----------
docs/sensor_v1.4_backup.py

